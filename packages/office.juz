{
  "manifest": {
    "id": "office",
    "name": "Juzeppe Office",
    "name_ru": "Juzeppe Office",
    "description": "Documents, tables, text colors, symbols and printing",
    "description_ru": "Документы, таблицы, цветной текст, символы и печать",
    "version": "1.0.0",
    "api": 1,
    "entry": "main.lua",
    "order": 100,
    "icon": [
      "111110",
      "100010",
      "111110",
      "101110",
      "101010",
      "111110"
    ],
    "short": "Office",
    "short_ru": "Офис",
    "author": "Juzeppe"
  },
  "files": {
    "main.lua": "local c=...\nlocal P=c.colors\nlocal WIDTH,HEIGHT,MAX_LINES=25,21,420\nlocal digits=\"0123456789abcdef\"\nlocal dyes={\"White\",\"Orange\",\"Magenta\",\"Light blue\",\"Yellow\",\"Lime\",\"Pink\",\"Gray\",\"Light gray\",\"Cyan\",\"Purple\",\"Blue\",\"Brown\",\"Green\",\"Red\",\"Black\"}\nlocal dyesRu={\"Белый\",\"Оранжевый\",\"Пурпурный\",\"Голубой\",\"Жёлтый\",\"Лайм\",\"Розовый\",\"Серый\",\"Светло-серый\",\"Бирюзовый\",\"Фиолетовый\",\"Синий\",\"Коричневый\",\"Зелёный\",\"Красный\",\"Чёрный\"}\nlocal rows={{t=\"\",f=\"\"}}\nlocal row,col,top,left=1,1,1,1\nlocal ink=\"f\"\nlocal anchor,dragging,path,dirty,overwrite\nlocal pasteUntil=0\nlocal mode=\"document\"\nlocal tableDraft,printJob\nlocal locale=dofile(\"/juzeppe/system/locale.lua\")\nlocal fileops=dofile(\"/juzeppe/system/fileops.lua\")\nlocal function tr(en,ru) return c.getLanguage()==\"en\" and en or ru end\nlocal function notice(en,ru) c.status(tr(en,ru)) end\nlocal function glyphs(s)\n  locale.mode=c.getLanguage()\n  return locale.render(tostring(s)):gsub(\"\\r\\n\",\"\\n\"):gsub(\"\\r\",\"\\n\"):gsub(\"\\t\",\"    \"):gsub(\"[%z\\1-\\8\\11-\\31]\",\"\")\nend\nlocal function resetCursor()\n  row,col,top,left,anchor=1,1,1,1,nil\nend\nlocal function changed() dirty=true; c.invalidate() end\nlocal function positionLess(a,b)\n  return a[1]<b[1] or (a[1]==b[1] and a[2]<b[2])\nend\nlocal function selection()\n  local p={row,col}\n  if not anchor or (anchor[1]==row and anchor[2]==col) then return end\n  if positionLess(anchor,p) then return anchor,p end\n  return p,anchor\nend\nlocal function selectedRange(i)\n  local a,b=selection()\n  if not a or i<a[1] or i>b[1] then return end\n  return i==a[1] and a[2] or 1,i==b[1] and b[2]-1 or #rows[i].t\nend\nlocal function splice(first,last,replacement)\n  if #rows-(last-first+1)+#replacement>MAX_LINES then\n    notice(\"Document is full\",\"Документ заполнен\"); return false\n  end\n  local result={}\n  for i=1,first-1 do result[#result+1]=rows[i] end\n  for _,line in ipairs(replacement) do result[#result+1]=line end\n  for i=last+1,#rows do result[#result+1]=rows[i] end\n  rows=result\n  changed(); return true\nend\nlocal function splitLine(t,f,out)\n  local start=1\n  repeat\n    out[#out+1]={t=t:sub(start,start+WIDTH-1),f=f:sub(start,start+WIDTH-1)}\n    start=start+WIDTH\n  until start>#t\nend\nlocal function insert(text,raw)\n  text=raw and text or glyphs(text)\n  if #text>WIDTH*MAX_LINES then notice(\"Text is too long\",\"Слишком длинный текст\"); return end\n  local a,b=selection()\n  a,b=a or {row,col},b or {row,col}\n  if overwrite and not anchor and not text:find(\"\\n\",1,true) then\n    b={row,math.min(#rows[row].t+1,col+#text)}\n  end\n  local prefix,preColor=rows[a[1]].t:sub(1,a[2]-1),rows[a[1]].f:sub(1,a[2]-1)\n  local suffix,sufColor=rows[b[1]].t:sub(b[2]),rows[b[1]].f:sub(b[2])\n  local replacement={}\n  local parts={}\n  for line in (text..\"\\n\"):gmatch(\"(.-)\\n\") do parts[#parts+1]=line end\n  local cursorRow,cursorCol\n  for i,p in ipairs(parts) do\n    local t,f=p,string.rep(ink,#p)\n    if i==1 then t,f=prefix..t,preColor..f end\n    if i==#parts then\n      cursorRow=#replacement+math.max(1,math.ceil(#t/WIDTH))\n      cursorCol=#t==0 and 1 or ((#t-1)%WIDTH+2)\n      t,f=t..suffix,f..sufColor\n    end\n    splitLine(t,f,replacement)\n  end\n  if splice(a[1],b[1],replacement) then\n    row,col=a[1]+cursorRow-1,cursorCol\n    anchor=nil\n    return true\n  end\nend\nlocal function move(r,x,selecting)\n  if selecting then anchor=anchor or {row,col} else anchor=nil end\n  row=math.max(1,math.min(#rows,r))\n  col=math.max(1,math.min(#rows[row].t+1,x))\nend\nlocal function moveHorizontal(delta,selecting)\n  if delta<0 and col==1 and row>1 then move(row-1,#rows[row-1].t+1,selecting)\n  elseif delta>0 and col>#rows[row].t and row<#rows then move(row+1,1,selecting)\n  else move(row,col+delta,selecting) end\nend\nlocal function erase(back)\n  if not selection() then\n    local oldRow,oldCol=row,col\n    moveHorizontal(back and -1 or 1,true)\n    if row==oldRow and col==oldCol then anchor=nil; return end\n  end\n  insert(\"\",true)\nend\nlocal function copy(cut)\n  local a,b=selection()\n  if not a then return end\n  local lines={}\n  for i=a[1],b[1] do\n    local first,last=selectedRange(i)\n    lines[#lines+1]=rows[i].t:sub(first,last)\n  end\n  c.clipboard:setText(table.concat(lines,\"\\n\"))\n  if cut then insert(\"\",true) else notice(\"Copied\",\"Скопировано\") end\nend\nlocal function setInk(code)\n  ink=code\n  if selection() then\n    for i,line in ipairs(rows) do\n      local first,last=selectedRange(i)\n      if first and last>=first then line.f=line.f:sub(1,first-1)..string.rep(code,last-first+1)..line.f:sub(last+1) end\n    end\n    changed()\n  end\n  mode=\"document\"\nend\nlocal function documentName()\n  return path and fs.getName(path) or \"Document.jdoc\"\nend\nlocal function resolve(value)\n  value=value:match(\"^%s*(.-)%s*$\")\n  if value==\"\" then return end\n  return \"/\"..fs.combine(value:sub(1,1)==\"/\" and \"\" or c.desktopPath,value):gsub(\"^/+\",\"\")\nend\nlocal function saveTo(target,plain)\n  if fs.exists(target) and fs.isDir(target) then notice(\"Choose a file\",\"Укажите файл\"); return end\n  local data\n  if plain then\n    local lines={}\n    for i,line in ipairs(rows) do lines[i]=line.t end\n    data=table.concat(lines,\"\\n\")\n  else data=textutils.serialize({format=\"JuzeppeOffice/1\",lines=rows}) end\n  local parent=fs.getDir(target)\n  local temporary=fileops.unique(parent,\".office-write\")\n  local backup=fileops.unique(parent,\".office-backup\")\n  local ok,err=pcall(function()\n    if not fs.exists(parent) then fs.makeDir(parent) end\n    local handle,why=fs.open(temporary,\"w\")\n    if not handle then error(why,0) end\n    local wrote,writeError=pcall(handle.write,data)\n    handle.close()\n    if not wrote then error(writeError,0) end\n    if fs.exists(target) then fs.move(target,backup) end\n    fs.move(temporary,target)\n  end)\n  if not ok then\n    if fs.exists(backup) and not fs.exists(target) then pcall(fs.move,backup,target) end\n    if fs.exists(temporary) then pcall(fs.delete,temporary) end\n    c.status(\"Save: \"..tostring(err)); return\n  end\n  if fs.exists(backup) then pcall(fs.delete,backup) end\n  if not plain then path,dirty=target,false end\n  c.refreshDesktop(); notice(\"Saved\",\"Сохранено\")\nend\nlocal function save(as,plain)\n  if path and not as and not plain then saveTo(path,false); return end\n  local initial=plain and documentName():gsub(\"%.jdoc$\",\".txt\") or (path or c.desktopPath..\"/Document.jdoc\")\n  c.prompt(tr(\"Save file\",\"Сохранить файл\"),initial,function(value)\n    local target=resolve(value)\n    if not target then return end\n    local ext=plain and \".txt\" or \".jdoc\"\n    if target:lower():sub(-#ext)~=ext then target=target..ext end\n    if fs.exists(target) and target~=path then c.confirm(tr(\"Replace existing file?\",\"Заменить файл?\"),function() saveTo(target,plain) end)\n    else saveTo(target,plain) end\n  end)\nend\nlocal function beforeDiscard(fn)\n  if dirty then c.confirm(tr(\"Discard unsaved changes?\",\"Не сохранять изменения?\"),fn) else fn() end\nend\nlocal function openDoc()\n  beforeDiscard(function()\n    c.prompt(tr(\"Open .jdoc or .txt\",\"Открыть .jdoc или .txt\"),c.desktopPath..\"/\",function(value)\n      local target=resolve(value)\n      if not target or not fs.exists(target) or fs.isDir(target) then notice(\"File not found\",\"Файл не найден\"); return end\n      if fs.getSize(target)>250000 then notice(\"File is too large\",\"Файл слишком большой\"); return end\n      local data=c.read(target)\n      if not data then notice(\"Cannot read file\",\"Ошибка чтения\"); return end\n      local result={}\n      if target:lower():match(\"%.jdoc$\") then\n        local doc=textutils.unserialize(data)\n        if type(doc)~=\"table\" or doc.format~=\"JuzeppeOffice/1\" or type(doc.lines)~=\"table\" or #doc.lines<1 or #doc.lines>MAX_LINES then\n          notice(\"Invalid document\",\"Неверный документ\"); return\n        end\n        for i,line in ipairs(doc.lines) do\n          if type(line)~=\"table\" or type(line.t)~=\"string\" or type(line.f)~=\"string\" or #line.t>WIDTH or #line.f~=#line.t or line.f:find(\"[^0-9a-f]\") or line.t:find(\"[%z\\1-\\31]\") then\n            notice(\"Invalid document\",\"Неверный документ\"); return\n          end\n          result[i]={t=line.t,f=line.f}\n        end\n        path,dirty=target,false\n      else\n        for line in (glyphs(data)..\"\\n\"):gmatch(\"(.-)\\n\") do splitLine(line,string.rep(\"f\",#line),result) end\n        if #result>MAX_LINES then notice(\"Too many lines\",\"Слишком много строк\"); return end\n        path,dirty=nil,true\n      end\n      rows=result; resetCursor(); notice(\"Opened\",\"Открыто\")\n    end)\n  end)\nend\nlocal function newDoc()\n  beforeDiscard(function() rows={{t=\"\",f=\"\"}}; path,dirty=nil,false; resetCursor(); ink=\"f\"; notice(\"New document\",\"Новый документ\") end)\nend\nlocal function openTable()\n  c.prompt(tr(\"Columns (2-6)\",\"Столбцы (2-6)\"),\"3\",function(value)\n    local n=tonumber(value)\n    if not n or n%1~=0 or n<2 or n>6 then notice(\"Enter 2-6 columns\",\"Введите 2-6 столбцов\"); return end\n    c.prompt(tr(\"Rows (1-15)\",\"Строки (1-15)\"),\"3\",function(v)\n      local count=tonumber(v)\n      if not count or count%1~=0 or count<1 or count>15 then notice(\"Enter 1-15 rows\",\"Введите 1-15 строк\"); return end\n      local cells={}\n      for i=1,count do cells[i]={}; for j=1,n do cells[i][j]=\"\" end end\n      tableDraft={cells=cells,columns=n,width=math.floor((WIDTH-n-1)/n),top=1,left=1}\n      mode=\"table\"\n    end)\n  end)\nend\nlocal function insertTable()\n  local d=tableDraft\n  local separator=\"+\"..string.rep(string.rep(\"-\",d.width)..\"+\",d.columns)\n  local lines={separator}\n  for _,cells in ipairs(d.cells) do\n    local line=\"|\"\n    for _,value in ipairs(cells) do line=line..value..string.rep(\" \",d.width-#value)..\"|\" end\n    lines[#lines+1]=line; lines[#lines+1]=separator\n  end\n  local before=#rows[row].t>0 and \"\\n\" or \"\"\n  if insert(before..table.concat(lines,\"\\n\")..\"\\n\",true) then mode=\"document\"; tableDraft=nil end\nend\nlocal function printers()\n  local names={}\n  for _,name in ipairs(peripheral.getNames()) do\n    if peripheral.hasType(name,\"printer\") then names[#names+1]=name end\n  end\n  table.sort(names); return names\nend\nlocal function startPrint()\n  local list=printers()\n  if #list==0 then notice(\"Connect a printer\",\"Подключите принтер\"); return end\n  local function choose(name)\n    printJob={name=name,page=1,total=math.ceil(#rows/HEIGHT),preview=true,viewTop=1}\n    mode=\"print\"\n  end\n  if #list==1 then choose(list[1]); return end\n  local entries={}\n  for _,name in ipairs(list) do local selected=name; entries[#entries+1]={label=name,action=function() choose(selected) end} end\n  c.menu(entries,1,2)\nend\nlocal function passes(page,mono)\n  if mono then return {\"f\"} end\n  local seen,result={},{}\n  for i=(page-1)*HEIGHT+1,math.min(page*HEIGHT,#rows) do\n    local line=rows[i]\n    for j=1,#line.t do if line.t:sub(j,j)~=\" \" then seen[line.f:sub(j,j)]=true end end\n  end\n  for code in digits:gmatch(\".\") do if seen[code] then result[#result+1]=code end end\n  if #result==0 then result[1]=\"f\" end\n  return result\nend\nlocal function preparePage()\n  local j=printJob\n  j.passes=passes(j.page,j.mono); j.pass=1; j.pending=false\nend\nlocal function printPass()\n  local j=printJob\n  if not j or j.done then return false end\n  local printer=peripheral.wrap(j.name)\n  if not printer or not peripheral.hasType(j.name,\"printer\") then notice(\"Printer disconnected\",\"Принтер отключён\"); return end\n  local ok,err=pcall(function()\n    if not j.pending then\n      if printer.getInkLevel()<1 then error(tr(\"Add dye\",\"Добавьте краситель\"),0) end\n      if printer.getPaperLevel()<1 then error(tr(\"Add paper or previous printout\",\"Положите бумагу или отпечаток\"),0) end\n      if not printer.newPage() then error(tr(\"Cannot start page; check tray\",\"Проверьте лоток принтера\"),0) end\n      j.pending=true\n    end\n    local w,h=printer.getPageSize()\n    if w<WIDTH or h<HEIGHT then error(\"Unsupported paper size: \"..w..\"x\"..h,0) end\n    local code=j.passes[j.pass]\n    local title=documentName():gsub(\"%.jdoc$\",\"\")..\" \"..j.page..\"/\"..j.total\n    printer.setPageTitle(glyphs(title):sub(1,32))\n    local first=(j.page-1)*HEIGHT+1\n    for i=first,math.min(first+HEIGHT-1,#rows) do\n      local line=rows[i]\n      if j.mono then printer.setCursorPos(1,i-first+1); printer.write(line.t)\n      else\n        local x=1\n        while x<=#line.t do\n          local stop=x\n          while stop<#line.t and line.f:sub(stop+1,stop+1)==line.f:sub(x,x) do stop=stop+1 end\n          if line.f:sub(x,x)==code then\n            printer.setCursorPos(x,i-first+1); printer.write(line.t:sub(x,stop))\n          end\n          x=stop+1\n        end\n      end\n    end\n    if not printer.endPage() then error(tr(\"Empty output tray; retry\",\"Освободите выходной лоток\"),0) end\n    j.pending=false\n  end)\n  if not ok then c.status(tostring(err)); return false end\n  if j.pass<#j.passes then j.pass=j.pass+1\n  elseif j.page<j.total then j.page=j.page+1; preparePage()\n  else j.done=true end\n  notice(j.done and \"Printing completed\" or \"Pass completed\",j.done and \"Печать завершена\" or \"Проход завершён\")\n  return true\nend\nlocal function printNext()\n  if not printJob.mono then printPass(); return end\n  while not printJob.done do\n    if not printPass() then return end\n  end\nend\nlocal function beginPrint(mono)\n  printJob.preview=false; printJob.mono=mono; preparePage()\nend\nlocal function fileMenu()\n  local entries={\n    {label=tr(\"New\",\"Новый\"),action=newDoc},\n    {label=tr(\"Open...\",\"Открыть...\"),action=openDoc},\n    {label=tr(\"Save / Ctrl+S\",\"Сохранить / Ctrl+S\"),action=function() save(false) end},\n    {label=tr(\"Save as...\",\"Сохранить как...\"),action=function() save(true) end},\n    {label=tr(\"Export TXT\",\"Экспорт TXT\"),action=function() save(true,true) end},\n    {label=tr(\"Print / Ctrl+P\",\"Печать / Ctrl+P\"),action=startPrint}\n  }\n  c.menu(entries,1,2)\nend\nlocal function toolsMenu()\n  c.menu({\n    {label=tr(\"Text color\",\"Цвет текста\"),action=function() mode=\"colors\" end},\n    {label=tr(\"Insert table\",\"Вставить таблицу\"),action=openTable},\n    {label=tr(\"Insert symbol\",\"Вставить символ\"),action=function() mode=\"symbols\" end},\n    {label=tr(\"Overwrite / Insert\",\"Замена / Insert\"),action=function() overwrite=not overwrite end},\n    {label=tr(\"Select all\",\"Выделить всё\"),action=function() anchor={1,1}; row,col=#rows,#rows[#rows].t+1 end},\n    {label=tr(\"Copy\",\"Копировать\"),action=function() copy(false) end},\n    {label=tr(\"Paste\",\"Вставить\"),action=function() local v=c.clipboard:getText(); if v then insert(v,true) end end}\n  },7,2)\nend\nlocal function swatch(code) return 2^(tonumber(code,16)) end\nlocal function back() mode=\"document\" end\nlocal function title(en,ru)\n  c.rect(1,1,c.width,1,P.deep)\n  c.raw(1,1,tr(en,ru),P.paper,P.deep)\nend\nlocal function drawDocument()\n  local w,h=c.width,c.height\n  c.rect(1,1,w,1,P.deep)\n  c.button(1,1,tr(\" File \",\" Файл \"),fileMenu,P.deep)\n  c.button(7,1,tr(\" Edit \",\" Правка \"),toolsMenu,P.deep)\n  c.button(w-6,1,tr(\" Print \",\" Печать\"),startPrint,P.accent)\n  c.rect(1,2,w,1,P.tint)\n  c.button(1,2,\" A \",function() mode=\"colors\" end,swatch(ink),ink==\"f\" and P.paper or P.ink)\n  c.button(5,2,tr(\"Table\",\"Табл.\"),openTable,P.deep)\n  c.button(11,2,tr(\"Symbol\",\"Символ\"),function() mode=\"symbols\" end,P.deep)\n  if w>=26 then c.button(19,2,tr(\"Save\",\"Сохр.\"),function() save(false) end,P.accent) end\n  c.raw(1,3,(dirty and \"* \" or \"\")..documentName(),P.muted)\n  local visible=math.max(1,h-4)\n  local paperWidth=math.min(WIDTH+1,math.max(1,w-4))\n  local x=math.floor((w-paperWidth)/2)+1\n  top=math.max(1,math.min(top,row))\n  if row>=top+visible then top=row-visible+1 end\n  left=math.max(1,math.min(left,col))\n  if col>=left+paperWidth then left=col-paperWidth+1 end\n  c.rect(1,4,w,visible,P.tint)\n  for y=1,visible do\n    local n=top+y-1\n    if n<=#rows then\n      local line=rows[n]\n      local t=line.t..string.rep(\" \",WIDTH+1-#line.t)\n      local f=line.f..string.rep(\"f\",WIDTH+1-#line.f)\n      local bg=string.rep(\"0\",WIDTH+1)\n      local a,b=selectedRange(n)\n      if a and b>=a then bg=bg:sub(1,a-1)..string.rep(\"8\",b-a+1)..bg:sub(b+1) end\n      if n==row then\n        bg=bg:sub(1,col-1)..\"7\"..bg:sub(col+1)\n        f=f:sub(1,col-1)..(f:sub(col,col)==\"0\" and \"f\" or f:sub(col,col))..f:sub(col+1)\n      end\n      term.setCursorPos(x,y+3); term.blit(t:sub(left,left+paperWidth-1),f:sub(left,left+paperWidth-1),bg:sub(left,left+paperWidth-1))\n      if x>=3 then c.raw(1,y+3,n%HEIGHT==1 and \">\" or \" \",P.muted,P.tint) end\n    else c.rect(x,y+3,paperWidth,1,P.paper) end\n  end\n  c.rect(1,h,w,1,P.tint)\n  c.raw(1,h,string.format(\"%d:%d  P%d/%d %s\",row,col,math.ceil(row/HEIGHT),math.ceil(#rows/HEIGHT),overwrite and \"OVR\" or \"INS\"),P.ink,P.tint)\nend\nlocal colorTop=1\nlocal function drawColors()\n  title(\" Text color\",\" Цвет текста\")\n  local columns=math.max(1,math.floor(c.width/18))\n  local step=math.floor(c.width/columns)\n  local capacity=columns*math.max(1,c.height-2)\n  colorTop=math.max(1,math.min(colorTop,math.max(1,17-capacity)))\n  for i=colorTop,math.min(16,colorTop+capacity-1) do\n    local code=digits:sub(i,i)\n    local x,y=1+((i-colorTop)%columns)*step,2+math.floor((i-colorTop)/columns)\n    c.button(x,y,\"   \",function() setInk(code) end,swatch(code),P.ink)\n    c.button(x+3,y,tr(dyes[i],dyesRu[i]),function() setInk(code) end,P.paper,P.ink)\n  end\n  c.button(1,c.height,tr(\" Back \",\" Назад \"),back,P.deep)\n  if capacity<16 then\n    c.button(10,c.height,\" < \",function() colorTop=colorTop-capacity end,P.deep)\n    c.button(14,c.height,\" > \",function() colorTop=colorTop+capacity end,P.deep)\n  end\nend\nlocal symbols={\"!\",\"?\",\"@\",\"#\",\"$\",\"%\",\"&\",\"*\",\"+\",\"-\",\"=\",\"/\",\"\\\\\",\"|\",\"<\",\">\",\"[\",\"]\",\"(\",\")\",\"{\",\"}\",\"_\",\"~\",\"^\",\":\",\";\",\".\",\",\",\"'\",'\"'}\nfor i=128,159 do symbols[#symbols+1]=string.char(i) end\nlocal symbolTop=1\nlocal function drawSymbols()\n  title(\" Insert symbol\",\" Вставить символ\")\n  local columns=math.max(1,math.floor(c.width/3))\n  local capacity=columns*math.max(1,c.height-3)\n  symbolTop=math.max(1,math.min(symbolTop,math.max(1,#symbols-capacity+1)))\n  for k=1,capacity do\n    local symbol=symbols[symbolTop+k-1]\n    if symbol then\n      local x,y=1+((k-1)%columns)*3,2+math.floor((k-1)/columns)\n      c.button(x,y,\" \"..symbol..\" \",function() insert(symbol,true); back() end,P.tint,P.ink)\n    end\n  end\n  c.button(1,c.height,\" < \",function() symbolTop=math.max(1,symbolTop-capacity) end,P.deep)\n  c.button(5,c.height,\" > \",function() symbolTop=math.min(#symbols,symbolTop+capacity) end,P.deep)\n  c.button(10,c.height,tr(\" Back \",\" Назад \"),back,P.deep)\nend\nlocal function drawTable()\n  local d=tableDraft\n  title(\" Table editor\",\" Редактор таблицы\")\n  c.raw(1,2,tr(\"Click a cell to edit\",\"Нажмите на ячейку\"),P.muted)\n  local cellWidth=d.width+1\n  local visibleColumns=math.max(1,math.floor((c.width-3)/cellWidth))\n  local visibleRows=math.max(1,c.height-4)\n  d.top=math.max(1,math.min(d.top,math.max(1,#d.cells-visibleRows+1)))\n  d.left=math.max(1,math.min(d.left,math.max(1,d.columns-visibleColumns+1)))\n  for r=d.top,math.min(#d.cells,d.top+visibleRows-1) do\n    local y=3+r-d.top\n    c.raw(1,y,tostring(r),P.muted)\n    for k=d.left,math.min(d.columns,d.left+visibleColumns-1) do\n      local rr,kk=r,k\n      local value=d.cells[r][k]\n      local x=4+(k-d.left)*cellWidth\n      c.rect(x,y,d.width,1,P.tint)\n      term.setCursorPos(x,y); term.blit(value,string.rep(\"f\",#value),string.rep(\"6\",#value))\n      c.hit(x,y,d.width,1,function()\n        c.prompt(tr(\"Cell \",\"Ячейка \")..rr..\",\"..kk..\" (\"..d.width..\")\",value,function(v)\n          local cleaned=glyphs(v):gsub(\"\\n\",\" \")\n          if #cleaned>d.width then notice(\"Cell is too long\",\"Слишком длинное значение\"); return end\n          d.cells[rr][kk]=cleaned\n        end)\n      end)\n    end\n  end\n  c.button(1,c.height-1,\" < \",function() d.left=d.left-1 end,P.deep)\n  c.button(5,c.height-1,\" > \",function() d.left=d.left+1 end,P.deep)\n  c.button(9,c.height-1,\" ^ \",function() d.top=d.top-1 end,P.deep)\n  c.button(13,c.height-1,\" v \",function() d.top=d.top+1 end,P.deep)\n  c.button(1,c.height,tr(\" Insert \",\" Вставить \"),insertTable,P.accent)\n  c.button(c.width-7,c.height,tr(\" Cancel \",\" Отмена \"),function() tableDraft=nil; back() end,P.deep)\nend\nlocal function drawPrint()\n  local j=printJob\n  title(\" Print\",\" Печать\")\n  c.raw(1,2,j.name,P.muted)\n  c.raw(1,3,tr(\"Page \",\"Страница \")..j.page..\"/\"..j.total..\"  25x21\",P.ink)\n  if j.preview then\n    local first=(j.page-1)*HEIGHT+1\n    local height=math.max(1,c.height-6)\n    j.viewTop=math.max(1,math.min(j.viewTop,math.max(1,HEIGHT-height+1)))\n    for i=1,height do\n      local line=rows[first+j.viewTop+i-2]\n      if line and j.viewTop+i-1<=HEIGHT then\n        local n=math.min(c.width,#line.t)\n        if n>0 then term.setCursorPos(1,i+3); term.blit(line.t:sub(1,n),line.f:sub(1,n),string.rep(\"0\",n)) end\n      end\n    end\n    c.button(1,c.height-2,\" < \",function() j.page=math.max(1,j.page-1); j.viewTop=1 end,P.deep)\n    c.button(5,c.height-2,\" > \",function() j.page=math.min(j.total,j.page+1); j.viewTop=1 end,P.deep)\n    c.button(1,c.height-1,tr(\" Black \",\" Ч/Б \"),function() j.page=1; beginPrint(true) end,P.accent)\n    c.button(9,c.height-1,tr(\" Color \",\" Цвет \"),function() j.page=1; beginPrint(false) end,P.deep)\n  elseif j.done then c.raw(1,5,tr(\"All pages printed.\",\"Все страницы готовы.\"),P.foliage)\n  else\n    local index=tonumber(j.passes[j.pass],16)+1\n    c.raw(1,4,tr(\"Load dye: \",\"Краситель: \")..tr(dyes[index],dyesRu[index]))\n    c.raw(1,5,j.pass==1 and tr(\"Load blank paper.\",\"Новая бумага.\") or tr(\"Reinsert last printout.\",\"Вставьте отпечаток снова.\"))\n    if c.height>=8 then c.raw(1,6,j.pass>1 and tr(\"Remove other input paper.\",\"Уберите другую бумагу.\") or tr(\"Pass \",\"Проход \")..j.pass..\"/\"..#j.passes,P.muted) end\n    c.button(1,c.height-1,j.pending and tr(\" Retry \",\" Повтор \") or tr(\" Print \",\" Печатать \"),printNext,P.accent)\n  end\n  c.button(1,c.height,tr(\" Back \",\" Назад \"),function()\n    if j.pending then notice(\"Finish the current pass\",\"Завершите текущий проход\"); return end\n    if not j.preview and not j.done then c.confirm(tr(\"Cancel print job?\",\"Отменить печать?\"),function() printJob=nil; back() end)\n    else printJob=nil; back() end\n  end,P.deep)\nend\nlocal function event(_,e,a,b,y)\n  if mode~=\"document\" then\n    if e==\"mouse_scroll\" then\n      if mode==\"table\" then tableDraft.top=tableDraft.top+a\n      elseif mode==\"symbols\" then symbolTop=symbolTop+a*math.max(1,math.floor(c.width/3))\n      elseif mode==\"colors\" then colorTop=colorTop+a*math.max(1,math.floor(c.width/18))\n      elseif mode==\"print\" and printJob.preview then printJob.viewTop=printJob.viewTop+a end\n    elseif e==\"key\" and a==keys.escape and mode~=\"print\" then back() end\n    return\n  end\n  local mods=c.modifiers()\n  if e==\"char\" and not mods.ctrl and not mods.alt then insert(a)\n  elseif e==\"paste\" then if os.clock()>=pasteUntil then insert(a) end\n  elseif e==\"mouse_click\" or e==\"mouse_drag\" then\n    if a~=1 or y<4 or y>=c.height then return end\n    local paperWidth=math.min(WIDTH+1,math.max(1,c.width-4))\n    local x=math.floor((c.width-paperWidth)/2)+1\n    if e==\"mouse_click\" then dragging=true; move(top+y-4,left+b-x,mods.shift); anchor=anchor or {row,col}\n    elseif dragging then move(top+y-4,left+b-x,true) end\n  elseif e==\"mouse_up\" then dragging=false; if not selection() then anchor=nil end\n  elseif e==\"mouse_scroll\" then move(row+a*3,col,false)\n  elseif e==\"key\" then\n    if mods.ctrl then\n      if a==keys.s then save(mods.shift)\n      elseif a==keys.o then openDoc()\n      elseif a==keys.n then newDoc()\n      elseif a==keys.p then startPrint()\n      elseif a==keys.a then anchor={1,1}; row,col=#rows,#rows[#rows].t+1\n      elseif a==keys.c then copy(false)\n      elseif a==keys.x then copy(true)\n      elseif a==keys.v then local v=c.clipboard:getText(); if v then insert(v,true); pasteUntil=os.clock()+0.18 end end\n    elseif a==keys.left then moveHorizontal(-1,mods.shift)\n    elseif a==keys.right then moveHorizontal(1,mods.shift)\n    elseif a==keys.up then move(row-1,col,mods.shift)\n    elseif a==keys.down then move(row+1,col,mods.shift)\n    elseif a==keys.home then move(row,1,mods.shift)\n    elseif a==keys[\"end\"] then move(row,#rows[row].t+1,mods.shift)\n    elseif a==keys.pageUp then move(row-math.max(1,c.height-4),col,mods.shift)\n    elseif a==keys.pageDown then move(row+math.max(1,c.height-4),col,mods.shift)\n    elseif a==keys.enter then insert(\"\\n\",true)\n    elseif a==keys.tab then insert(\"    \",true)\n    elseif a==keys.backspace then erase(true)\n    elseif a==keys.delete then erase(false)\n    elseif a==keys.insert then overwrite=not overwrite end\n  end\nend\nreturn {draw=function()\n  if c.width<22 or c.height<7 then c.raw(1,1,tr(\"Enlarge window\",\"Увеличьте окно\")); return end\n  if mode==\"document\" then drawDocument()\n  elseif mode==\"colors\" then drawColors()\n  elseif mode==\"symbols\" then drawSymbols()\n  elseif mode==\"table\" then drawTable()\n  elseif mode==\"print\" then drawPrint() end\nend,event=event,events={char=true,paste=true,key=true,mouse_click=true,mouse_drag=true,mouse_up=true,mouse_scroll=true,term_resize=true}}\n"
  }
}
