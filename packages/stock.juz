{
  "manifest": {
    "id": "stock",
    "name": "Stock",
    "name_ru": "\u0421\u043a\u043b\u0430\u0434",
    "short": "Stock",
    "short_ru": "\u0421\u043a\u043b\u0430\u0434",
    "description": "Browse items in a Create logistics network",
    "description_ru": "\u041e\u0441\u0442\u0430\u0442\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432 \u0441\u0435\u0442\u0438 Create",
    "version": "1.0.0",
    "api": 1,
    "entry": "main.lua",
    "order": 102,
    "icon": [
      "011110",
      "110011",
      "111111",
      "100001",
      "101101",
      "111111"
    ],
    "author": "Juzeppe",
    "permissions": [
      "stock.read"
    ]
  },
  "files": {
    "main.lua": "local ui=...\nlocal rows,matches={},{}\nlocal source,query,offset=nil,\"\",0\nlocal busy=false\nlocal function tr(en,ru) return ui.getLanguage()==\"en\" and en or ru end\nlocal function filter()\n  matches={}\n  for _,item in ipairs(rows) do\n    if item.name:lower():find(query:lower(),1,true) then matches[#matches+1]=item end\n  end\n  offset=0\n  ui.invalidate()\nend\nlocal function refresh(nextSource)\n  if busy then return end\n  busy=true\n  ui.status(tr(\"Reading stock...\",\"\u0427\u0438\u0442\u0430\u044e \u043e\u0441\u0442\u0430\u0442\u043a\u0438...\"))\n  ui.job(function()\n    local names=ui.stock.sources()\n    if #names==0 then return nil,tr(\"Connect a Stock Ticker\",\"\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 Stock Ticker\") end\n    local selected=names[1]\n    for i,name in ipairs(names) do\n      if name==source then selected=nextSource and names[i%#names+1] or name; break end\n    end\n    local items={}\n    for _,item in pairs(ui.stock.read(selected)) do\n      items[#items+1]={name=item.name,count=item.count}\n    end\n    table.sort(items,function(a,b)\n      if a.count==b.count then return a.name<b.name end\n      return a.count>b.count\n    end)\n    return items,selected\n  end,function(result,detail)\n    busy=false\n    rows=result or {}\n    source=result and detail or nil\n    filter()\n    ui.status(result and (detail..\" / \"..#rows) or tostring(detail))\n  end)\nend\nlocal function scroll(n)\n  offset=math.max(0,math.min(offset+n,#matches-math.max(1,ui.height-3)))\n  ui.invalidate()\nend\nrefresh(false)\nreturn {events={mouse_scroll=true,key=true},event=function(_,e,a)\n  if e==\"mouse_scroll\" then scroll(a)\n  elseif a==keys.up then scroll(-1)\n  elseif a==keys.down then scroll(1)\n  elseif a==keys.r then refresh(false) end\nend,draw=function(c)\n  c.button(1,1,tr(\" Sync \",\" \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \"),function() refresh(false) end)\n  c.button(11,1,tr(\" Find \",\" \u041f\u043e\u0438\u0441\u043a \"),function()\n    c.prompt(tr(\"Item ID\",\"ID \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\"),query,function(value) query=value; filter() end)\n  end)\n  c.button(19,1,tr(\" Src \",\" \u0421\u0435\u0442\u044c \"),function() refresh(true) end)\n  c.raw(1,2,query~=\"\" and query or tr(\"Item / quantity\",\"\u041f\u0440\u0435\u0434\u043c\u0435\u0442 / \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\"))\n  local height=math.max(1,c.height-3)\n  offset=math.max(0,math.min(offset,#matches-height))\n  for i=1,height do\n    local item=matches[offset+i]\n    if item then\n      local count=tostring(item.count)\n      local label=item.name:gsub(\"^minecraft:\",\"\")\n      c.raw(1,i+2,label:sub(1,math.max(1,c.width-#count-1)))\n      c.raw(math.max(1,c.width-#count+1),i+2,count)\n    end\n  end\n  if #matches==0 then c.raw(1,3,busy and \"...\" or tr(\"No items\",\"\u041d\u0435\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432\")) end\n  c.button(1,c.height,\" < \",function() scroll(-height) end)\n  c.button(5,c.height,\" > \",function() scroll(height) end)\nend}\n"
  }
}
