{
  "manifest": {
    "id": "stock",
    "name": "Stock",
    "name_ru": "\u0421\u043a\u043b\u0430\u0434",
    "short": "Stock",
    "short_ru": "\u0421\u043a\u043b\u0430\u0434",
    "description": "Local and wireless Create stock, native menu with Bridge",
    "description_ru": "\u0421\u043a\u043b\u0430\u0434 Create \u0438 \u0448\u0442\u0430\u0442\u043d\u043e\u0435 \u043c\u0435\u043d\u044e \u0447\u0435\u0440\u0435\u0437 Bridge",
    "version": "1.3.0",
    "api": 1,
    "entry": "main.lua",
    "order": 102,
    "icon": [
      "011110",
      "110011",
      "111111",
      "100001",
      "101101",
      "111111"
    ],
    "author": "Juzeppe",
    "permissions": [
      "stock.read",
      "stock.remote",
      "stock.native"
    ]
  },
  "files": {
    "main.lua": "local ui=...\nlocal rows,matches={},{}\nlocal source,query,offset=nil,\"\",0\nlocal config=ui.dataPath..\"/stock-host\"\nlocal remote=tonumber(ui.read(config) or \"\")\nlocal busy=false\nlocal function tr(en,ru) return ui.getLanguage()==\"en\" and en or ru end\nlocal function validID(id)\n  return id and id>=0 and id<=2147483647 and id%1==0\nend\nif not validID(remote) then remote=nil end\nlocal function connection()\n  return remote and (\"Remote #\"..remote) or (source or tr(\"Local ticker\",\"\u041c\u0435\u0441\u0442\u043d\u044b\u0439 \u0442\u0438\u043a\u0435\u0440\"))\nend\nlocal function filter()\n  matches={}\n  for _,item in ipairs(rows) do\n    if item.name:lower():find(query:lower(),1,true) then matches[#matches+1]=item end\n  end\n  offset=0\n  ui.invalidate()\nend\nlocal function refresh(nextSource)\n  if busy then return end\n  busy=true\n  ui.status(tr(\"Reading stock...\",\"\u0427\u0438\u0442\u0430\u044e \u043e\u0441\u0442\u0430\u0442\u043a\u0438...\"))\n  local ok=ui.job(function()\n    local result,selected\n    if remote then\n      if not ui.stock.remote then return nil,\"Update JuzeppeOS to 0.8.3\" end\n      local err\n      result,err=ui.stock.remote(remote)\n      if not result then return nil,err end\n      selected=\"#\"..remote\n    else\n      local names=ui.stock.sources()\n      if #names==0 then return nil,tr(\"Connect a Stock Ticker or choose Link\",\"\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0442\u0438\u043a\u0435\u0440 \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 Link\") end\n      selected=names[1]\n      for i,name in ipairs(names) do\n        if name==source then selected=nextSource and names[i%#names+1] or name; break end\n      end\n      result=ui.stock.read(selected)\n    end\n    local items={}\n    for _,item in pairs(result) do\n      items[#items+1]={name=item.name,count=item.count}\n    end\n    table.sort(items,function(a,b)\n      if a.count==b.count then return a.name<b.name end\n      return a.count>b.count\n    end)\n    return items,selected\n  end,function(result,detail)\n    busy=false\n    if result then\n      rows=result\n      source=detail\n      filter()\n      ui.status(tr(\"Updated: \",\"\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e: \")..#rows)\n    else\n      ui.status(tostring(detail)..(#rows>0 and tr(\" (old data)\",\" (\u0441\u0442\u0430\u0440\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435)\") or \"\"))\n      ui.invalidate()\n    end\n  end)\n  if not ok then busy=false; ui.status(\"Busy\") end\nend\nlocal function link()\n  if busy then ui.status(tr(\"Wait for refresh or stop it\",\"\u0414\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\")); return end\n  ui.prompt(tr(\"Host computer ID (empty = local)\",\"ID \u043a\u043e\u043c\u043f. \u0441\u043a\u043b\u0430\u0434\u0430 (\u043f\u0443\u0441\u0442\u043e = \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e)\"),remote and tostring(remote) or \"\",function(value)\n    value=value:match(\"^%s*(.-)%s*$\")\n    local id=tonumber(value)\n    if value~=\"\" and not validID(id) then ui.status(tr(\"Invalid computer ID\",\"\u041d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 ID\")); return end\n    local ok,err=ui.write(config,value==\"\" and \"\" or tostring(id))\n    if not ok then ui.status(tostring(err)); return end\n    remote=id\n    source=nil\n    rows={}\n    filter()\n    refresh(false)\n  end)\nend\nlocal function openNative()\n  if busy then ui.status(tr(\"Wait for refresh\",\"\u0414\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\")); return end\n  if not ui.stock.openNative then ui.status(\"Update JuzeppeOS to 0.8.5\"); return end\n  busy=true\n  ui.status(tr(\"Opening Create...\",\"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u044e Create...\"))\n  local ok=ui.job(function() return ui.stock.openNative(remote) end,function(opened,detail)\n    busy=false\n    ui.status(opened and tr(\"Create menu opened\",\"\u041c\u0435\u043d\u044e Create \u043e\u0442\u043a\u0440\u044b\u0442\u043e\") or tostring(detail))\n    ui.invalidate()\n  end)\n  if not ok then busy=false end\nend\nlocal function browseSources()\n  ui.menu({\n    {label=tr(\"Wireless host ID...\",\"\u0411\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0439 \u0441\u043a\u043b\u0430\u0434...\"),action=link},\n    {label=tr(\"Next local ticker\",\"\u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u0442\u0438\u043a\u0435\u0440\"),action=function()\n      if remote then ui.status(tr(\"Set Link to empty first\",\"\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0435 ID \u0432 Link\"))\n      else refresh(true) end\n    end}\n  },1,2)\nend\nlocal function scroll(n)\n  offset=math.max(0,math.min(offset+n,#matches-math.max(1,ui.height-4)))\n  ui.invalidate()\nend\nrefresh(false)\nreturn {events={mouse_scroll=true,key=true},event=function(_,e,a)\n  if e==\"mouse_scroll\" then scroll(a)\n  elseif a==keys.up then scroll(-1)\n  elseif a==keys.down then scroll(1)\n  elseif a==keys.r then refresh(false)\n  elseif a==keys.l then link() elseif a==keys.g then openNative() end\nend,draw=function(c)\n  if c.width<21 or c.height<6 then c.raw(1,1,\"Resize window\"); return end\n  c.button(1,1,\" Sync \",function() refresh(false) end)\n  c.button(8,1,\" Find \",function()\n    c.prompt(tr(\"Item ID\",\"ID \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\"),query,function(value) query=value; filter() end)\n  end)\n  c.button(15,1,\" Link \",link)\n  c.raw(1,2,connection(),c.colors.muted)\n  c.raw(1,3,query~=\"\" and query or tr(\"Item / quantity\",\"\u041f\u0440\u0435\u0434\u043c\u0435\u0442 / \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\"))\n  local height=math.max(1,c.height-4)\n  offset=math.max(0,math.min(offset,#matches-height))\n  for i=1,height do\n    local item=matches[offset+i]\n    if item then\n      local count=tostring(item.count)\n      local label=item.name:gsub(\"^minecraft:\",\"\")\n      c.raw(1,i+3,label:sub(1,math.max(1,c.width-#count-1)))\n      c.raw(math.max(1,c.width-#count+1),i+3,count)\n    end\n  end\n  if #matches==0 then c.raw(1,4,busy and \"...\" or tr(\"No items\",\"\u041d\u0435\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432\")) end\n  c.button(1,c.height,\" < \",function() scroll(-height) end)\n  c.button(5,c.height,\" > \",function() scroll(height) end)\n  c.button(9,c.height,\" Src \",browseSources)\n  c.button(16,c.height,\" GUI \",openNative)\nend}\n"
  }
}
