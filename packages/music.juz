{
  "manifest": {
    "id": "music",
    "name": "Juzeppe Music",
    "name_ru": "\u041c\u0443\u0437\u044b\u043a\u0430",
    "short": "Music",
    "short_ru": "\u041c\u0443\u0437",
    "description": "Find and play music from Muzmos",
    "description_ru": "\u041f\u043e\u0438\u0441\u043a \u0438 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0443\u0437\u044b\u043a\u0438 Muzmos",
    "version": "1.0.0",
    "api": 1,
    "entry": "main.lua",
    "order": 105,
    "icon": [
      "011110",
      "010010",
      "010010",
      "110110",
      "110110",
      "000000"
    ],
    "author": "Juzeppe",
    "permissions": [
      "music.playback"
    ]
  },
  "files": {
    "main.lua": "local ui=...\nlocal offset=0\nlocal lastQuery=\"\"\nlocal function tr(en,ru) return ui.getLanguage()==\"en\" and en or ru end\nlocal function command(name,value)\n  local ok,err=ui.music.command(name,value)\n  if not ok then ui.status(err) end\n  ui.invalidate()\nend\nlocal function search()\n  ui.prompt(tr(\"Song or artist\",\"\u041f\u0435\u0441\u043d\u044f \u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\"),ui.music.status().query,function(value)\n    offset=0; command(\"search\",value)\n  end)\nend\nlocal function scroll(n)\n  local s=ui.music.status()\n  local count=math.max(1,math.floor((ui.height-5)/2))\n  offset=math.max(0,math.min(offset+n,math.max(0,#s.tracks-count)))\n  ui.invalidate()\nend\nlocal function draw(c)\n  local s=c.music.status()\n  local w,h=c.width,c.height\n  local P=c.colors\n  c.rect(1,1,w,1,P.deep)\n  c.raw(2,1,\"J U Z E P P E  MUSIC\",P.paper,P.deep)\n  c.rect(1,2,w,1,P.tint)\n  c.button(1,2,tr(\" Search \",\" \u041f\u043e\u0438\u0441\u043a \"),search,P.accent,P.paper)\n  c.raw(10,2,s.query~=\"\" and s.query or \"MUZMOS\",P.muted,P.tint)\n  if w<22 or h<7 then c.raw(1,3,\"Resize window\"); return end\n  if not s.available then\n    c.raw(2,4,tr(\"Install Bridge 0.3.0\",\"\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 Bridge 0.3.0\"),P.danger)\n    c.raw(2,5,tr(\"on the server\",\"\u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435\"))\n    return\n  end\n  if lastQuery~=s.query then offset=0; lastQuery=s.query end\n  local count=math.max(1,math.floor((h-5)/2))\n  offset=math.max(0,math.min(offset,math.max(0,#s.tracks-count)))\n  for i=1,count do\n    local track=s.tracks[offset+i]\n    if track then\n      local y=3+(i-1)*2\n      local bg=i%2==0 and P.tint or P.paper\n      c.rect(1,y,w,2,bg)\n      c.raw(1,y,s.selected==track.id and \" > \" or \" + \",P.paper,P.oasis)\n      c.raw(5,y,track.title,P.ink,bg)\n      c.raw(5,y+1,track.artist,P.muted,bg)\n      c.hit(1,y,w,2,function() command(\"play\",track.id) end)\n    end\n  end\n  if #s.tracks==0 then\n    c.raw(2,3,s.searchState==\"loading\" and tr(\"Searching...\",\"\u0418\u0449\u0443...\") or tr(\"Search for a song\",\"\u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u043f\u0435\u0441\u043d\u044e\"),P.muted)\n  end\n  c.rect(1,h-2,w,2,P.tint)\n  c.raw(1,h-2,s.title~=\"\" and s.title or tr(\"Nothing playing\",\"\u041d\u0435\u0442 \u043c\u0443\u0437\u044b\u043a\u0438\"),P.ink,P.tint)\n  local time=string.format(\"%02d:%02d\",math.floor(s.elapsed/60),s.elapsed%60)\n  local state=s.playState==\"playing\" and \"PLAY\" or s.playState==\"paused\" and \"PAUSE\" or\n    s.playState==\"buffering\" and \"LOAD\" or s.playState==\"finished\" and \"DONE\" or \"STOP\"\n  c.raw(1,h-1,state..\" \"..time..\"  \"..math.floor(s.volume*100+.5)..\"%\",P.muted,P.tint)\n  c.button(1,h,s.playState==\"paused\" and \" > \" or \" || \",function() command(\"pause\") end,P.oasis,P.paper)\n  c.button(6,h,\" X \",function() command(\"stop\") end,P.danger,P.paper)\n  c.button(10,h,\" - \",function() command(\"volume\",-.1) end,P.tint,P.ink)\n  c.button(14,h,\" + \",function() command(\"volume\",.1) end,P.tint,P.ink)\n  if w>=27 then c.button(w-6,h,\" ^ \",function() scroll(-count) end,P.tint,P.ink); c.button(w-3,h,\" v \",function() scroll(count) end,P.tint,P.ink) end\n  c.status(s.notice)\nend\nreturn {refresh=true,draw=draw,events={mouse_scroll=true,key=true},\n  event=function(c,e,a)\n    if e==\"mouse_scroll\" then scroll(a)\n    elseif e==\"key\" and a==keys.up then scroll(-1)\n    elseif e==\"key\" and a==keys.down then scroll(1)\n    elseif e==\"key\" and a==keys.s then search()\n    elseif e==\"key\" and a==keys.space then command(\"pause\")\n    elseif e==\"key\" and a==keys.escape then command(\"stop\") end\n  end}\n"
  }
}
